# ─────────────────────────────────────────────────────────────────
#  Transit Sleep Agent — Environment Variables
#  Copy file này thành .env rồi điền giá trị thực
#    cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# Token từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=7xxxxxxxxx:AAxxxxxx-xxxxxxxxxxxxxxxxxxxxxx

# API key từ openrouteservice.org (free tier: 2000 req/ngày)
ORS_API_KEY=eyJvcm...

# URL public của backend (ngrok khi dev, Koyeb URL khi production)
# Dev:        https://xxxx-xx-xx-xx-xx.ngrok-free.app
# Production: https://<app-name>-<hash>.koyeb.app
BACKEND_URL=https://xxxx-xx-xx-xx-xx.ngrok-free.app

# URL của Mini App = BACKEND_URL + /miniapp
MINI_APP_URL=https://xxxx-xx-xx-xx-xx.ngrok-free.app/miniapp

# Chat ID Telegram của bạn — lấy từ @userinfobot
OWNER_CHAT_ID=123456789

# ntfy.sh push notification — bypass silent mode / DND trên Android
# 1. Cài app "ntfy" (Android/iOS, miễn phí): https://ntfy.sh
# 2. Đặt tên topic bất kỳ (chỉ bạn biết, càng random càng khó đoán)
# 3. Trong app: Add subscription → nhập topic này
# Để trống = tắt tính năng ntfy, các alert Telegram vẫn hoạt động bình thường
NTFY_TOPIC=transit-sleep-agent-yourname-xxxx
